{
  "expo": {
    "name": "DoIt2",
    "slug": "doit2",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "doit2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.doit2.app"
    },
    "android": {
      "package": "com.doit2.app",
      "adaptiveIcon": {
        "backgroundColor": "#5AB0FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5AB0FF"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "다녀온 곳의 사진을 기록에 남기려면 사진 접근 권한이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "오늘 날씨를 보고 비 오는 날 실외 데이트를 빼려면 위치 권한이 필요해요."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#5AB0FF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "공유 카드를 사진 앨범에 저장하려면 사진 권한이 필요해요.",
          "savePhotosPermission": "공유 카드를 사진 앨범에 저장하려면 사진 권한이 필요해요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6a0569cb-d991-4d3c-b576-756d70eafaa2"
      }
    },
    "owner": "epww1502",
    "updates": {
      "url": "https://u.expo.dev/6a0569cb-d991-4d3c-b576-756d70eafaa2"
    }
  }
}
