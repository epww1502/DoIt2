{
  "expo": {
    "name": "DoIt2",
    "slug": "doit2",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "doit2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.doit2.app"
    },
    "android": {
      "package": "com.doit2.app",
      "adaptiveIcon": {
        "backgroundColor": "#5AB0FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5AB0FF"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "다녀온 곳의 사진을 기록에 남기려면 사진 접근 권한이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "오늘 날씨를 보고 비 오는 날 실외 데이트를 빼려면 위치 권한이 필요해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
