# 이 파일을 .env 로 복사하고 값을 채운다 (.env 는 git에 올라가지 않는다)

# Supabase 프로젝트 주소와 공개 키 (대시보드 > Project Settings > API Keys)
# 공개용 값이라 앱에 들어가도 괜찮다. 데이터 보호는 RLS 정책이 한다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 카카오 REST API 키는 앱이 아니라 Supabase Edge Function 시크릿(KAKAO_REST_API_KEY)에 넣는다.

# 카카오 웹 지도(장소 검색의 '지도' 보기)용 JavaScript 키 (카카오 개발자 콘솔 > 앱 키 > JavaScript 키)
# 웹 지도 키는 원래 공개용이다. 대신 콘솔 > 플랫폼 > Web 에 https://map.doit2.app 을 등록해야 지도가 열린다 (lib/kakaoMapHtml.ts 의 KAKAO_MAP_BASE_URL).
EXPO_PUBLIC_KAKAO_JS_KEY=
