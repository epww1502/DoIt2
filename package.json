{
  "name": "doit2",
  "main": "expo-router/entry",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "postinstall": "patch-package",
    "test": "jest",
    "eval:ai": "node scripts/ai-eval/run-eval.mjs --flow .claude/hillclimb/ai-suggest --variant baseline --model claude-haiku-5-5 --reps 2 --concurrency 3 --timeout-s 180",
    "update": "for p in android ios; do npx eas-cli update --channel production --environment production --platform $p --message \"$(git log -1 --pretty=%s)\" || exit 1; npm run sourcemaps || echo \"Sentry source maps skipped for $p\"; done",
    "sourcemaps": "npx eas-cli env:exec production \"node scripts/upload-sourcemaps.js dist\" --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/black-han-sans": "^0.4.1",
    "@expo-google-fonts/do-hyeon": "^0.4.1",
    "@expo-google-fonts/gaegu": "^0.4.1",
    "@expo-google-fonts/jua": "^0.4.1",
    "@expo-google-fonts/single-day": "^0.4.2",
    "@expo-google-fonts/sunflower": "^0.4.2",
    "@expo-google-fonts/yeon-sung": "^0.4.1",
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/slot": "^1.5.2",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "expo": "~58.0.26",
    "expo-background-task": "~58.0.13",
    "expo-build-properties": "~58.0.12",
    "expo-calendar": "~58.0.8",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-location": "~58.0.22",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-share-intent": "^9.0.0",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.29",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.2.7",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "3.3.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "30.0.0",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "babel-preset-expo": "^58.0.19",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lint-staged": "^15.5.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
