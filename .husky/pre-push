# GitHub Desktop: bare `npm` resolves to `C:/Program Files/nodejs/npm` and fails on spaces
NODE_HOME="/c/Program Files/nodejs"
NODE="$NODE_HOME/node.exe"
NPM_CLI="$NODE_HOME/node_modules/npm/bin/npm-cli.js"
export PATH="$NODE_HOME:$PATH"

run_npm() {
  if [ -x "$NODE" ] && [ -f "$NPM_CLI" ]; then
    "$NODE" "$NPM_CLI" "$@"
  else
    npm "$@"
  fi
}

echo "🔍 Running pre-push checks..."

# ESLint 체크 (warning은 허용, error만 실패)
echo "📝 Running ESLint..."
run_npm run lint
lint_exit_code=$?
if [ $lint_exit_code -ne 0 ]; then
  echo "❌ ESLint check failed. Please fix the errors and try again."
  exit 1
fi
echo "✅ ESLint check passed"

# TypeScript 타입 체크
echo "🔷 Running TypeScript type check..."
run_npm run type-check || {
  echo "❌ TypeScript type check failed. Please fix the errors and try again."
  exit 1
}

# Prettier 포맷 체크
echo "💅 Running Prettier format check..."
run_npm run format:check || {
  echo "❌ Prettier format check failed. Please run 'npm run format' to fix formatting issues."
  exit 1
}

echo "✅ All pre-push checks passed!"
